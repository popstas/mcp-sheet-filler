{
  "name": "mcp-sheet-filler",
  "version": "1.0.0",
  "description": "MCP server for storing and safely auto-filling tabular data",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "TRANSPORT=http node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:http": "TRANSPORT=http DEBUG_LOG=data/mcp.log tsx src/index.ts",
    "auth": "tsx src/index.ts auth",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src"
  },
  "keywords": [
    "mcp",
    "sheets"
  ],
  "author": "Stanislav Popov",
  "license": "MIT",
  "dependencies": {
    "@googleapis/sheets": "^10.0.0",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "better-sqlite3": "^12.6.2",
    "google-auth-library": "^10.3.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.9",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.17"
  }
}
